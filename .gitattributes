# Normaliza todos los archivos de texto a LF en el repositorio
* text=auto eol=lf

# Fuerza LF en archivos de texto del proyecto
*.py    text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.spec  text eol=lf
*.toml  text eol=lf
*.txt   text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf

# Binarios: no tocar
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.exe   binary
*.dll   binary
*.pyd   binary
*.woff  binary
*.woff2 binary